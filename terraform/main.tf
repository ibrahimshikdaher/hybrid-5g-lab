# ---------- Ubuntu 22.04 AMI ----------
# The AMI ID is passed in as var.ami_id (set in terraform.tfvars) because the
# organization's service control policy blocks ec2:DescribeImages and
# ssm:GetParameter, so Terraform cannot look the image up itself.

# ---------- SSH key (generated by Terraform) ----------
resource "tls_private_key" "ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "this" {
  key_name   = "${var.project_name}-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_file" "ssh_private_key" {
  content         = tls_private_key.ssh.private_key_pem
  filename        = "${path.module}/${var.project_name}-key.pem"
  file_permission = "0400"
}

# ---------- Network ----------
resource "aws_vpc" "this" {
  cidr_block           = "10.50.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = { Name = "${var.project_name}-vpc" }
}

resource "aws_internet_gateway" "this" {
  vpc_id = aws_vpc.this.id
  tags   = { Name = "${var.project_name}-igw" }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.this.id
  cidr_block              = "10.50.1.0/24"
  map_public_ip_on_launch = true

  tags = { Name = "${var.project_name}-public" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.this.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.this.id
  }

  tags = { Name = "${var.project_name}-rt" }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# ---------- Security group ----------
resource "aws_security_group" "core" {
  name        = "${var.project_name}-sg"
  description = "Open5GS core: WireGuard in, admin access via VPN"
  vpc_id      = aws_vpc.this.id

  # WireGuard is open to any address because the home IPv4 address changes.
  # Only packets signed with the right keys are answered, so the risk is low.
  ingress {
    description = "WireGuard"
    from_port   = 51820
    to_port     = 51820
    protocol    = "udp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # SSH and the Open5GS WebUI are reached through the VPN (10.200.0.1), so they
  # need no public rule. Optionally open SSH for one address by setting
  # admin_cidr (for example "203.0.113.5/32"), e.g. to debug a broken tunnel.
  dynamic "ingress" {
    for_each = var.admin_cidr == "" ? [] : [var.admin_cidr]
    content {
      description = "SSH from admin address (optional)"
      from_port   = 22
      to_port     = 22
      protocol    = "tcp"
      cidr_blocks = [ingress.value]
    }
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project_name}-sg" }
}

# ---------- EC2 instance ----------
resource "aws_instance" "core" {
  ami                    = var.ami_id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.core.id]
  key_name               = aws_key_pair.this.key_name

  # Needed so the instance can forward UE traffic
  source_dest_check = false

  root_block_device {
    volume_size = var.disk_size_gb
    volume_type = "gp3"
  }

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    wg_private_key  = var.aws_wg_private_key
    wg_home_pubkey  = var.home_wg_public_key
    wg_aws_address  = var.wg_aws_address
    wg_home_address = var.wg_home_address
    mcc             = var.mcc
    mnc             = var.mnc
  })

  user_data_replace_on_change = true

  tags = { Name = "${var.project_name}-core" }
}

# ---------- Elastic IP ----------
resource "aws_eip" "core" {
  domain   = "vpc"
  instance = aws_instance.core.id

  tags = { Name = "${var.project_name}-eip" }

  depends_on = [aws_internet_gateway.this]
}
